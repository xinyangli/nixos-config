Subject: [PATCH] feat: Add POSIX attribute support to ServiceAccount

Extends the schema introduced by oddlama/kanidm-provision#29 with the same
enable_unix / gid_number / login_shell fields that 6862c31 (PR #31) added
for Person and Group, and wires sync_service_accounts to POST the unix
attributes through the existing KanidmClient::update_unix_attrs helper.

Hunk positions match upstream main (304a048b) with PR #29 + PR #34 applied
on top, which is the layout produced by overlays/add-pkgs.nix.

---
 src/main.rs  | 10 ++++++++++
 src/state.rs |  4 ++++
 2 files changed, 14 insertions(+)

diff --git a/src/main.rs b/src/main.rs
--- a/src/main.rs
+++ b/src/main.rs
@@ -217,6 +217,16 @@ fn sync_service_accounts(
             update_attrs!(kanidm_client, ENDPOINT_SERVICE_ACCOUNT, &existing_service_accounts, &name, false, [
                 "displayname": vec![service_account.display_name.clone()],
                 "entry_managed_by": vec![ service_account.entry_managed_by.clone() ],
             ]);
+            if service_account.enable_unix {
+                let mut unix_attrs = HashMap::new();
+                if let Some(gid_number) = &service_account.gid_number {
+                    unix_attrs.insert("gidnumber", gid_number.clone().into());
+                }
+                if let Some(login_shell) = &service_account.login_shell {
+                    unix_attrs.insert("loginshell", login_shell.clone().into());
+                }
+                let _ = kanidm_client.update_unix_attrs(ENDPOINT_SERVICE_ACCOUNT, &name, unix_attrs);
+            }
         } else if existing_service_accounts.contains_key(name) {
             kanidm_client.delete_entity(ENDPOINT_SERVICE_ACCOUNT, name)?;
         }
diff --git a/src/state.rs b/src/state.rs
--- a/src/state.rs
+++ b/src/state.rs
@@ -44,6 +44,10 @@ pub struct ServiceAccount {
     #[serde(default = "default_true")]
     pub present: bool,
     pub display_name: String,
     pub entry_managed_by: String,
+    #[serde(default = "default_false")]
+    pub enable_unix: bool,
+    pub gid_number: Option<u32>,
+    pub login_shell: Option<String>,
 }

 #[derive(Debug, Deserialize)]
