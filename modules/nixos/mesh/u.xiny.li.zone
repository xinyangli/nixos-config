; u.xiny.li — internal mesh zone served via anycast by every host with
; `custom.mesh-network.dns.server.enable = true;` (see ./dns.nix).
;
; Each `<host>.u.xiny.li` AAAA maps to the host's primary mesh ULA
; (`custom.mesh-network.address` first entry). Keep this file in sync
; with peers.nix and each machine's mesh-network.address block.
$ORIGIN u.xiny.li.
$TTL 60
@       IN SOA  ns admin (
                1       ; serial
                3600    ; refresh
                900     ; retry
                604800  ; expire
                60      ; minimum
                )
@       IN NS   ns
ns      IN AAAA fda1:6cbb:db78::53

fra-00   IN AAAA fda1:6cbb:db78::1
la-00    IN AAAA fda1:6cbb:db78::2
thorite  IN AAAA fda1:6cbb:db78::3
biotite  IN AAAA fda1:6cbb:db78::4
cinnabar IN AAAA fda1:6cbb:db78::5
hafnon   IN AAAA fda1:6cbb:db78::6
